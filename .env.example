# ==============================================================================
# NEXUS CODE PLAY — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# IMPORTANT: Never commit actual passwords, private keys, or credentials to git.
# Copy this file to .env or configure in your server/Docker environment.

APP_ENV=development
PORT=3000

# MariaDB Server on HP EliteDesk 800 G3 Mini (Docker / Tailscale / Internal Network)
# Dedicated unprivileged application user: nexus_app (NEVER root!)
DB_HOST=100.70.45.109
DB_PORT=3306
DB_NAME=nexus_code_play
DB_USER=nexus_app
DB_PASSWORD=your-secure-database-password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=5000

# Private local media storage (not served as a static directory)
MEDIA_STORAGE_PATH=./var/media

# Google Gemini AI Integration (server-side proxy)
GEMINI_API_KEY=your-gemini-api-key

# App Hosting & OAuth Callback URL
APP_URL=http://localhost:3000

# Session / JWT Authentication Secret (for future microservices & JWT tokens)
JWT_SECRET=your-jwt-secure-random-secret
